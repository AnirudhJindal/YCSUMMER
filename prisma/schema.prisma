generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  supabaseId String   @unique
  email      String   @unique
  createdAt  DateTime @default(now())

  apiKeys      ApiKey[]
  tokens       TokenVault[]
  logs         AuditLog[]
  forcedValues UserForcedMaskValue[]
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  keyHash    String    @unique
  name       String
  active     Boolean   @default(true)
  requests   Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user         User                  @relation(fields: [userId], references: [id])
  forcedValues UserForcedMaskValue[]
}

model TokenVault {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  realValue String
  valueHash String   // ✅ added
  type      String
  createdAt DateTime @default(now())
  lastUsed  DateTime

  user        User                 @relation(fields: [userId], references: [id])
  forcedValue UserForcedMaskValue?

  @@index([token, userId])
  @@index([valueHash, userId]) // ✅ added
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  token     String
  action    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model UserForcedMaskValue {
  id        String   @id @default(uuid())
  userId    String
  keyId     String?
  label     String?
  token     String   @unique
  createdAt DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id])
  key   ApiKey?     @relation(fields: [keyId], references: [id])
  vault TokenVault  @relation(fields: [token], references: [token])
}