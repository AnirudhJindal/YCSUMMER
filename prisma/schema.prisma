generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * USER TABLE
 * One row per developer using your API
 */
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  apiKeys ApiKey[]
  tokens  TokenVault[]
  logs    AuditLog[] // ✅ ADD THIS
}

/**
 * API KEY TABLE
 * Used for authenticating requests
 */
model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  keyHash    String    @unique
  name       String // "test", "prod"
  active     Boolean   @default(true)
  requests   Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

/**
 * TOKEN VAULT (CORE TABLE)
 * Maps token → encrypted real value
 */
model TokenVault {
  id        String   @id @default(uuid())
  token     String
  userId    String
  realValue String // encrypted value
  type      String // PHONE, EMAIL, BANK, etc
  createdAt DateTime @default(now())
  lastUsed  DateTime

  user User @relation(fields: [userId], references: [id])

  @@index([token, userId]) // 🔥 critical for fast lookup
}

/**
 * OPTIONAL (but recommended)
 * Track who accessed what
 */
model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  token     String
  action    String // "mask" | "unmask"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}


